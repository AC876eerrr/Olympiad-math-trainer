# Olympiad Math Trainer — environment configuration
# Copy this file to `.env` and fill in the values. NEVER commit `.env` to git.

# Port the server listens on (hosts like Render set this automatically)
PORT=3000

# Public base URL of the site, no trailing slash. Used for Stripe redirect URLs.
# Local dev: http://localhost:3000
# Production: https://olympiadmath.xyz
BASE_URL=http://localhost:3000

# Where the SQLite database file lives.
# Local dev default: ./data/app.db (relative to repo root)
# Production (Render disk): /data/app.db
DB_PATH=./data/app.db

# Secret used to sign session cookies. Set a long random string in production.
# If unset, a dev default is used (sessions still work, but not secure).
SESSION_SECRET=change-me-to-a-long-random-string

# ---- Stripe (Pro checkout). Leave blank to run WITHOUT online payments ----
# When these are absent, /api/billing/checkout returns a clean
# "coming soon" response instead of crashing, and billing.html shows a
# "contact the owner" message.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_MONTHLY=
STRIPE_PRICE_ANNUAL=
